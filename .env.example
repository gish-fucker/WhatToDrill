HOST=127.0.0.1
PORT=5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
ADVICE_RATE_LIMIT=10
ACCOUNT_RATE_LIMIT=5
UPSTREAM_TIMEOUT_MS=20000
TRUST_PROXY=0
# Only enable behind a proxy that removes untrusted forwarding headers or appends
# its own values. Set hops to the exact number of trusted proxies nearest the app.
TRUST_PROXY_HOPS=1
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloud backup is configured when URL, anon key, and service-role key are all set.
CLOUD_SYNC_IP_RATE_LIMIT=60
CLOUD_SYNC_ACCOUNT_RATE_LIMIT=30
CLOUD_SYNC_RATE_WINDOW_MS=60000
# Entitlement/quota RPCs are independent from cloud backup and stay off unless explicitly enabled.
ENTITLEMENTS_ENABLED=0
FREE_AI_ADVICE_LIMIT=3
PRO_AI_ADVICE_LIMIT=100
